{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streaming",
  "compatibility_date": "2026-07-28",
  "main": ".output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "streaming.jimtracker.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}